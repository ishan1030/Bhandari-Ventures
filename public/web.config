<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS configuration for the Bhandari Ventures static site.
  Sits at the site root (e.g. C:\inetpub\wwwroot\web.config).
-->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <staticContent>
      <!-- Correct MIME types -->
      <remove fileExtension=".svg" />
      <add fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <add fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- HTML at the root always revalidates so updates show up -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <!-- gzip static + dynamic responses -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

  <!-- Fingerprinted build assets can be cached hard (filenames change on rebuild) -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
